CREATE TABLE IF NOT EXISTS audit(id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER, actor TEXT, action TEXT, detail TEXT);
"""
def connect(path=":memory:"):
    c = sqlite3.connect(path, check_same_thread=False); c.row_factory = sqlite3.Row
    if path != ":memory:": c.execute("PRAGMA journal_mode=WAL")
    c.executescript(SCHEMA); return c

# ===== engine =====
ROUND_MS, LOCK_BEFORE_MS, STALE_MS, PAYOUT = 300_000, 30_000, 15_000, 1.9
NEXT = {"CREATED": {"OPEN"}, "OPEN": {"LOCKED"}, "LOCKED": {"SETTLED", "REVIEW"}, "SETTLED": set(), "REVIEW": {"SETTLED"}}
class RoundError(Exception): pass

class Engine:
    def __init__(self, db=None, round_ms=ROUND_MS, lock_before_ms=LOCK_BEFORE_MS):
        self.db = db or connect(); self.paused = False; self.on_pause = None; self.round_ms, self.lock_before_ms = round_ms, lock_before_ms
    def _audit(self, actor, action, detail, ts=0):
        self.db.execute("INSERT INTO audit(ts,actor,action,detail) VALUES(?,?,?,?)", (ts, actor, action, json.dumps(detail)))
    def _move(self, ts, new):
        cur = self.db.execute("SELECT state FROM rounds WHERE open_ts=?", (ts,)).fetchone()
        if not cur or new not in NEXT[cur["state"]]: raise RoundError(f"illegal transition {cur and cur['state']}->{new}")
        self.db.execute("UPDATE rounds SET state=? WHERE open_ts=?", (new, ts))
    def credit(self, user, amt, key, reason="deposit", ts=0):
        try: self.db.execute("INSERT INTO ledger(user,delta,idem_key,reason,ts) VALUES(?,?,?,?,?)", (user, amt, key, reason, ts)); return True
        except Exception: return False  # duplicate idempotency key -> no second payout
    def balance(self, user): return self.db.execute("SELECT COALESCE(SUM(delta),0) b FROM ledger WHERE user=?", (user,)).fetchone()["b"]
    def create_round(self, open_ts, ref_price, forecast):
        """Round opens only with a persisted forecast (saved before outcome is known)."""
        if ref_price is None or ref_price <= 0: raise RoundError("invalid reference price")
        self.db.execute("INSERT INTO rounds VALUES(?,?,?,?,?,?,?,?)", (open_ts, ref_price, open_ts+self.round_ms-self.lock_before_ms, open_ts+self.round_ms, "CREATED", None, None, None))
        f = forecast
        self.db.execute("INSERT INTO forecasts VALUES(?,?,?,?,?,?,?,?,?,?)", (open_ts, f["made_ts"], f["model"], f["version"], f.get("p_up"), f["decision"],
            json.dumps(f.get("features")), json.dumps(f.get("evidence")), f.get("explanation"), f.get("data_quality")))
        self._move(open_ts, "OPEN")
    def bet(self, user, open_ts, side, stake, now):
        if self.paused: raise RoundError("paused")
        r = self.db.execute("SELECT * FROM rounds WHERE open_ts=?", (open_ts,)).fetchone()
        if not r or r["state"] != "OPEN" or now >= r["lock_ts"]: raise RoundError("round not accepting predictions")
        if stake <= 0 or stake > self.balance(user): raise RoundError("invalid stake or insufficient virtual credits")
        cur = self.db.execute("INSERT INTO bets(round_ts,user,side,stake) VALUES(?,?,?,?)", (open_ts, user, side, stake))
        self.credit(user, -stake, f"stake:{cur.lastrowid}", "stake", now); return cur.lastrowid
    def lock(self, open_ts, now):
        r = self.db.execute("SELECT lock_ts FROM rounds WHERE open_ts=?", (open_ts,)).fetchone()
        if now < r["lock_ts"]: raise RoundError("too early to lock")
        self._move(open_ts, "LOCKED")
    def settle(self, open_ts, close_price, price_ts, now):
        """Closing price = last validated trade at/before close_ts. Stale/missing -> REVIEW, never silent."""
        r = self.db.execute("SELECT * FROM rounds WHERE open_ts=?", (open_ts,)).fetchone()
        if r["state"] == "SETTLED": return "already_settled"
        if now < r["close_ts"]: raise RoundError("round not finished")
        bad = (close_price is None or close_price <= 0 or price_ts is None or price_ts > r["close_ts"] + STALE_MS
               or r["close_ts"] - price_ts > STALE_MS)
        if r["state"] == "LOCKED" and bad:
            self._move(open_ts, "REVIEW"); self.db.execute("UPDATE rounds SET note='stale or missing closing price' WHERE open_ts=?", (open_ts,))
            self._audit("engine", "review", {"round": open_ts}, now); return "review"
        if r["state"] not in ("LOCKED", "REVIEW") or bad: raise RoundError("cannot settle")
        res = "UP" if close_price > r["ref_price"] else "DOWN" if close_price < r["ref_price"] else "TIE"
        self._move(open_ts, "SETTLED")
        self.db.execute("UPDATE rounds SET close_price=?, result=? WHERE open_ts=?", (close_price, res, open_ts))
        for b in self.db.execute("SELECT * FROM bets WHERE round_ts=? AND status='OPEN'", (open_ts,)).fetchall():
            pay = b["stake"] if res == "TIE" else b["stake"]*PAYOUT if b["side"] == res else 0.0
            if pay: self.credit(b["user"], pay, f"payout:{b['id']}", "payout", now)
            self.db.execute("UPDATE bets SET status=? WHERE id=?", ("REFUND" if res == "TIE" else "WON" if pay else "LOST", b["id"]))
        self._audit("engine", "settled", {"round": open_ts, "result": res}, now); self.db.commit(); return res

# ===== model =====
VERSION = "baseline-vol-normal-1"
def phi(z): return 0.5*(1+math.erf(z/math.sqrt(2)))
def features(closes_1m, price):
    """Uses only data available at forecast time (closes strictly before now)."""
    if len(closes_1m) < 20: return None
    r = [math.log(b/a) for a, b in zip(closes_1m[:-1], closes_1m[1:])]
    m = sum(r)/len(r); sd = math.sqrt(sum((x-m)**2 for x in r)/(len(r)-1))
    mom5 = math.log(price/closes_1m[-5]); mom15 = math.log(price/closes_1m[-15])
    regime = "high_vol" if sd > 0.0012 else "low_vol"
    return {"vol_1m": sd, "mom5": mom5, "mom15": mom15, "regime": regime}
def forecast(closes_1m, price, ref_price, seconds_left, data_age_ms, thr=0.04, now=0, weights=None, version=None):
    f = features(closes_1m, price)
    if f is None or data_age_ms > 15000:
        return {"made_ts": now, "model": "baseline", "version": VERSION, "p_up": None, "decision": "NO_TRADE",
                "data_quality": "unavailable" if f is None else "stale", "explanation": "Insufficient or stale data."}
    sig = f["vol_1m"]/math.sqrt(60)*math.sqrt(max(seconds_left, 1))
    tilt = 0.1*math.tanh(f["mom5"]/(f["vol_1m"]*math.sqrt(5)))  # small, bounded
    ver = VERSION
    p = min(max(phi(math.log(price/ref_price)/sig + tilt), 0.01), 0.99)
    if weights and price == ref_price:  # learned model: P(up | momentum features at round open)
        p = min(max(_sig(sum(a*b for a, b in zip(weights, _x([f["vol_1m"]*100, f["mom5"]*100, f["mom15"]*100])))), 0.02), 0.98); ver = version or "learned"
    dec = "UP" if p >= .5+thr else "DOWN" if p <= .5-thr else "NO_TRADE"
    return {"made_ts": now, "model": "baseline" if ver == VERSION else "logit", "version": ver, "p_up": p, "decision": dec, "features": f, "data_quality": "ok",
            "explanation": f"Distance to target is {math.log(price/ref_price)/sig:+.2f} sigma; momentum tilt {tilt:+.3f}; threshold ±{thr}."}
def brier(ps, ys): return sum((p-y)**2 for p, y in zip(ps, ys))/len(ps)
def logloss(ps, ys, e=1e-9): return -sum(y*math.log(min(max(p, e), 1-e))+(1-y)*math.log(min(max(1-p, e), 1-e)) for p, y in zip(ps, ys))/len(ps)
def calibration(ps, ys, bins=5):
    out = []
    for i in range(bins):
        s = [(p, y) for p, y in zip(ps, ys) if i/bins <= p < (i+1)/bins or (i == bins-1 and p == 1)]
        if s: out.append({"bin": i, "n": len(s), "mean_p": sum(p for p, _ in s)/len(s), "freq_up": sum(y for _, y in s)/len(s)})
    return out
def promote(cand_ps, base_ps, ys, min_n=200, margin=0.002):
    """Chronological holdout gate: promote only if beats baseline Brier AND the 0.5 naive baseline, with enough data."""
    if len(ys) < min_n: return False, f"insufficient data ({len(ys)}<{min_n})"
    bc, bb, bn = brier(cand_ps, ys), brier(base_ps, ys), brier([0.5]*len(ys), ys)
    ok = bc < bb-margin and bc < bn
    return ok, f"candidate {bc:.4f} vs baseline {bb:.4f} vs naive {bn:.4f}"

# ===== learning (walk-forward, gated promotion) =====
def _sig(z): return 1/(1+math.exp(-max(-30, min(30, z))))
def _x(v):
    vol = max(abs(v[0]), 1e-9); return [1.0, max(-5, min(5, v[1]/vol)), max(-5, min(5, v[2]/vol))]
def fit_logit(X, y, l2=1.0, iters=300, lr=0.5, w=None):
    w, n = list(w) if w else [0.0]*3, len(X)
    for _ in range(iters):
        g = [0.0]*3
        for x, t in zip(X, y):
            e = _sig(sum(a*b for a, b in zip(w, x))) - t
            for j in range(3): g[j] += e*x[j]
        w = [w[j] - lr*(g[j]/n + (l2*w[j]/n if j else 0)) for j in range(3)]
    return w
def dataset(db):
    rows = db.execute("SELECT e.round_ts, e.vector, e.outcome, f.p_up FROM episodes e JOIN forecasts f ON f.round_ts=e.round_ts "
                      "WHERE e.outcome IN('UP','DOWN') ORDER BY e.round_ts").fetchall()
    return [(_x(json.loads(r["vector"])), 1.0 if r["outcome"] == "UP" else 0.0, 0.5 if r["p_up"] is None else r["p_up"]) for r in rows]
def active_model(db):
    r = db.execute("SELECT m.version, m.config FROM active_model a JOIN model_versions m ON m.version=a.version").fetchone()
    return (r["version"], json.loads(r["config"])["weights"]) if r else (None, None)
def learn(db, now, min_n=200, margin=0.002, refit_every=None, k0=None):
    """Expanding-window walk-forward: row i is predicted by a model trained only on rows < i. Promote only if it beats
    the production forecasts and a 0.5 guess on those same out-of-sample rows. Every evaluated candidate is stored immutably."""
    D = dataset(db)[-4000:]; n = len(D); k0 = k0 or max(50, n//3)  # retention window keeps runtime bounded
    regimes = db.execute("SELECT regime, COUNT(*) c, SUM(outcome='UP') u FROM episodes WHERE outcome IN('UP','DOWN') GROUP BY regime").fetchall()
    for r in regimes: db.execute("INSERT INTO lessons(ts,text,stats) VALUES(?,?,?)", (now, f"{r['regime']}: {r['u']}/{r['c']} rounds ended UP ({100*r['u']/r['c']:.1f}%)", json.dumps(dict(r))))
    if n-k0 < min_n: return {"promoted": False, "reason": f"insufficient data ({n-k0}<{min_n} walk-forward samples)", "n": n}
    refit_every = refit_every or max(10, (n-k0)//40)  # bounds cost: at most ~40 walk-forward refits
    cand, base, ys, w = [], [], [], None
    for i in range(k0, n):
        if w is None or (i-k0) % refit_every == 0: w = fit_logit([d[0] for d in D[:i]], [d[1] for d in D[:i]], iters=300 if w is None else 60, w=w)  # warm start
        cand.append(_sig(sum(a*b for a, b in zip(w, D[i][0])))); base.append(D[i][2]); ys.append(D[i][1])
    ok, msg = promote(cand, base, ys, min_n=min_n, margin=margin)
    final = fit_logit([d[0] for d in D], [d[1] for d in D]); ver = f"logit-{n}-{now}"
    m = {"n_walkforward": len(ys), "brier_candidate": brier(cand, ys), "brier_baseline": brier(base, ys), "brier_naive": brier([.5]*len(ys), ys),
         "logloss_candidate": logloss(cand, ys), "calibration": calibration(cand, ys), "gate": msg}
    db.execute("INSERT INTO model_versions VALUES(?,?,?,?)", (ver, json.dumps({"weights": final, "l2": 1.0}), json.dumps(m), now))
    if ok: db.execute("INSERT OR REPLACE INTO active_model VALUES(1,?)", (ver,))
    db.execute("INSERT INTO audit(ts,actor,action,detail) VALUES(?,?,?,?)", (now, "learner", "promoted" if ok else "rejected", json.dumps({"version": ver, "gate": msg})))
    return {"promoted": ok, "version": ver, "reason": msg, "n": n}

# ===== next-move model: P(close in H minutes > close now), trained on candle history =====
NM_FEATS = ["bias", "z1", "z5", "z15", "z30", "z60", "rsi14", "volratio"]
def nm_matrix(c):
    """Row i uses closes[:i+1] only. First 61 rows are NaN (insufficient history)."""
    c = np.asarray(c, float); n = len(c); lc = np.log(c); r = np.diff(lc, prepend=lc[0]); sw = np.lib.stride_tricks.sliding_window_view
    def roll(a, w, f):
        o = np.full(n, np.nan)
        if n >= w: o[w-1:] = f(sw(a, w))
        return o
    vol = roll(r, 60, lambda m: m.std(axis=1, ddof=1)); v10 = roll(r, 10, lambda m: m.std(axis=1, ddof=1))
    def z(k):
        o = np.full(n, np.nan); o[k:] = lc[k:]-lc[:-k]; return np.clip(o/(vol*np.sqrt(k)+1e-12), -5, 5)
    d = np.diff(c, prepend=c[0]); au = roll(np.clip(d, 0, None), 14, lambda m: m.mean(axis=1)); ad = roll(np.clip(-d, 0, None), 14, lambda m: m.mean(axis=1))
    rsi = np.where(au+ad > 0, au/(au+ad+1e-12), 0.5)
    X = np.column_stack([np.ones(n), z(1), z(5), z(15), z(30), z(60), (rsi-.5)*2, np.clip(np.log((v10+1e-12)/(vol+1e-12)), -2, 2)])
    X[:61] = np.nan; return X
def nm_fit(X, y, l2=1.0, iters=300, lr=0.5):
    w = np.zeros(X.shape[1]); reg = np.ones(len(w)); reg[0] = 0; n = len(y)
    for _ in range(iters): w -= lr*(X.T@(1/(1+np.exp(-np.clip(X@w, -30, 30)))-y)/n + l2*reg*w/n)
    return w
def nm_dataset(c, H):
    c = np.asarray(c, float); n = len(c); X = nm_matrix(c); y = np.full(n, np.nan)
    if n > H: y[:n-H] = np.where(c[H:] > c[:-H], 1.0, np.where(c[H:] < c[:-H], 0.0, np.nan))
    idx = np.where(~np.isnan(X).any(axis=1) & ~np.isnan(y))[0]; return X[idx], y[idx], idx
def nm_learn(db, closes, now, H=5, min_n=2000, margin=0.0003, start_frac=0.5, blocks=20, z_req=3.0):
    """Walk-forward with purging: every test block is predicted by a model trained only on samples whose H-minute labels were
    fully known before the block's first feature time. Promote only if Brier beats base-rate AND 0.5 and the paired improvement is >= z_req sigma."""
    X, y, idx = nm_dataset(closes, H); n = len(y); k0 = int(n*start_frac)
    if n-k0 < min_n: return {"promoted": False, "reason": f"insufficient data ({n-k0}<{min_n} test samples)", "n": n}
    B = max(200, (n-k0)//blocks); cand, base, ys, spans = [], [], [], []
    for s in range(k0, n, B):
        e_ = min(s+B, n); tr = np.where(idx+H <= idx[s])[0]; w = nm_fit(X[tr], y[tr])
        cand += (1/(1+np.exp(-np.clip(X[s:e_]@w, -30, 30)))).tolist(); base += [float(y[tr].mean())]*(e_-s); ys += y[s:e_].tolist(); spans.append((int(idx[tr].max()), int(idx[s])))
    c_, b_, y_ = np.array(cand), np.array(base), np.array(ys)
    dlt = (b_-y_)**2 - (c_-y_)**2; zs = float(dlt.mean()/(dlt.std()/math.sqrt(len(dlt))+1e-15))
    ok, msg = promote(cand, base, ys, min_n=min_n, margin=margin); ok = bool(ok and zs >= z_req)
    final = nm_fit(X, y); ver = f"nm{H}-{n}-{now}"
    m = {"horizon_min": H, "n_test": len(ys), "brier_candidate": brier(cand, ys), "brier_baseline": brier(base, ys), "brier_naive": brier([.5]*len(ys), ys),
         "accuracy_pct": float(100*((c_ >= .5) == (y_ == 1)).mean()), "z_vs_baseline": zs, "gate": msg, "spans": spans}
    db.execute("INSERT INTO model_versions VALUES(?,?,?,?)", (ver, json.dumps({"weights": final.tolist(), "features": NM_FEATS, "horizon": H}), json.dumps(m), now))
    db.execute("INSERT OR REPLACE INTO nm_pointer VALUES('lean',?)", (ver,))
    if ok: db.execute("INSERT OR REPLACE INTO nm_pointer VALUES('active',?)", (ver,))
    return {"promoted": ok, "version": ver, "z": round(zs, 2), "accuracy_pct": round(m["accuracy_pct"], 2), "brier_candidate": round(m["brier_candidate"], 5), "brier_baseline": round(m["brier_baseline"], 5), "n_test": len(ys), "gate": msg, "spans": spans}
def nm_load(db, kind):
    r = db.execute("SELECT m.version, m.config FROM nm_pointer p JOIN model_versions m ON m.version=p.version WHERE p.kind=?", (kind,)).fetchone()
    return (r["version"], np.array(json.loads(r["config"])["weights"])) if r else (None, None)
def nm_predict(db, closes, H=5, thr=0.005):
    """Next-H-minute direction. p_up/decision come ONLY from a validated model; 'lean' is the unvalidated best guess, labelled as such."""
    if len(closes) < 62: return None
    x = nm_matrix(closes)[-1]
    if np.isnan(x).any(): return None
    sg = lambda w: float(1/(1+np.exp(-np.clip(x@w, -30, 30))))
    va, wa = nm_load(db, "active"); vl, wl = nm_load(db, "lean")
    p = sg(wa) if wa is not None else 0.5; lean = sg(wl) if wl is not None else p
    dec = ("UP" if p >= .5+thr else "DOWN" if p <= .5-thr else "NO_TRADE") if wa is not None else "NO_TRADE"
    w = wa if wa is not None else wl
    why = sorted(([NM_FEATS[j], round(float(w[j]*x[j]), 4)] for j in range(1, len(x))), key=lambda t: -abs(t[1]))[:3] if w is not None else []
    return {"p_up": p, "lean_p": lean, "lean_dir": "UP" if lean >= .5 else "DOWN", "decision": dec, "validated": wa is not None, "version": va or vl, "top_drivers": why, "horizon_min": H}
def nm_forecast(db, closes, now, thr, H):
    p = nm_predict(db, closes, H, thr)
    if not p or not p["validated"]: return None
    return {"made_ts": now, "model": "nextmove", "version": p["version"], "p_up": p["p_up"], "decision": p["decision"], "features": None, "data_quality": "ok",
            "explanation": f"Validated {H}-minute model: P(up)={p['p_up']:.3f}; top drivers {p['top_drivers']}."}
def nm_stats(db):
    rs = db.execute("SELECT lean_p, outcome FROM nm_predictions WHERE settled=1 AND outcome IN('UP','DOWN')").fetchall()
    if not rs: return {"settled": 0}
    y = [1.0 if r["outcome"] == "UP" else 0.0 for r in rs]; p = [r["lean_p"] for r in rs]
    return {"settled": len(y), "lean_accuracy_pct": round(100*sum((a >= .5) == (b == 1) for a, b in zip(p, y))/len(y), 1), "lean_brier": round(brier(p, y), 5), "baseline_brier": round(brier([.5]*len(y), y), 5)}
def fill_grid(rows):
    rows = sorted(set(rows)); d = dict(rows); t0, t1 = rows[0][0], rows[-1][0]; n = (t1-t0)//60000+1; out, last, miss = [], rows[0][1], 0
    for k in range(n):
        v = d.get(t0+60000*k)
        if v is None: miss += 1; v = last
        out.append(v); last = v
    return out, miss/n, t0

# ===== memory =====
import json, math
def save_episode(db, round_ts, regime, vector, summary, source, now):
    db.execute("INSERT OR IGNORE INTO episodes(round_ts,created_ts,regime,vector,summary,source) VALUES(?,?,?,?,?,?)", (round_ts, now, regime, json.dumps(vector), summary, source))
def record_outcome(db, round_ts, outcome): db.execute("UPDATE episodes SET outcome=? WHERE round_ts=?", (outcome, round_ts))
def similar(db, vector, before_ts, k=5):
    """Only episodes with known outcomes created before the query time (no leakage)."""
    rows = db.execute("SELECT * FROM episodes WHERE outcome IS NOT NULL AND created_ts<?", (before_ts,)).fetchall()
    d = lambda r: math.dist(vector, json.loads(r["vector"]))
    return [{"round_ts": r["round_ts"], "distance": d(r), "outcome": r["outcome"], "source": r["source"]} for r in sorted(rows, key=d)[:k]]
def delete_episode(db, round_ts, actor="user", now=0):
    db.execute("DELETE FROM episodes WHERE round_ts=?", (round_ts,)); db.execute("INSERT INTO audit(ts,actor,action,detail) VALUES(?,?,?,?)", (now, actor, "delete_memory", str(round_ts)))

