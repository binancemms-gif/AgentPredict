# ===== market adapter (swap this class to change provider) =====
class CoinbaseAdapter:
    def __init__(self, product="SOL-USD"): self.base = f"https://api.exchange.coinbase.com/products/{product}"
    def _get(self, path):
        req = urllib.request.Request(self.base + path, headers={"User-Agent": "lexi-oracle"})
        with urllib.request.urlopen(req, timeout=8) as r: return json.load(r)
    async def latest(self):
        j = await asyncio.to_thread(self._get, "/ticker")
        ts = int(datetime.datetime.fromisoformat(j["time"].replace("Z", "+00:00")).timestamp()*1000)
        p = float(j["price"])
        if not p > 0: raise ValueError("invalid price")
        return {"price": p, "ts": ts}
    async def candles(self, now_ms, n=300):
        rows = await asyncio.to_thread(self._get, "/candles?granularity=60")
        return sorted((r[0]*1000, r[4]) for r in rows if r[0]*1000+60000 <= now_ms)[-n:]
    async def history(self, now_ms, minutes):
        out, end = set(), now_ms//60000*60000
        iso = lambda ms: datetime.datetime.fromtimestamp(ms/1000, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        while end > now_ms - minutes*60000:
            rows = await asyncio.to_thread(self._get, f"/candles?granularity=60&start={iso(end-300*60000)}&end={iso(end-60000)}")
            out.update((r[0]*1000, r[4]) for r in rows); end -= 300*60000; await asyncio.sleep(0.2)
        return sorted(out)
    async def closes(self, now_ms):
        rows = await asyncio.to_thread(self._get, "/candles?granularity=60")
        return [r[4] for r in sorted(r for r in rows if (r[0]+60)*1000 <= now_ms)]  # completed 1m candles only

# ===== autonomous runner =====
class Autonomous:
    """One deterministic tick() per call: lock, settle, open. Safe to run every second, restart, or run twice."""
    def __init__(self, engine, adapter, analyst=None, user="agent", stake=10.0, grace_ms=20_000, thr=0.04, pause_file=None, learn_every=25):
        self.e, self.a, self.analyst, self.user, self.stake, self.grace, self.thr, self.pf = engine, adapter, analyst, user, stake, grace_ms, thr, pause_file
        self.learn_every, self.last_n = learn_every, 0
        self.days, self.last_refresh, self.nm_min, self.nm_thr = int(os.getenv('LEXI_HISTORY_DAYS', '14')), -10**15, -1, 0.005
        if pause_file: engine.on_pause = lambda: open(pause_file, "a").close()
    def _maybe_learn(self, now):
        n = self.e.db.execute("SELECT COUNT(*) FROM episodes WHERE outcome IN('UP','DOWN')").fetchone()[0]
        if n - self.last_n >= self.learn_every:
            self.last_n = n; self.e._audit("learner", "run", learn(self.e.db, now), now)
    async def _nm(self, now):
        e = self.e; H = e.round_ms//60000
        if now - self.last_refresh >= 6*3600*1000:
            self.last_refresh = now; rows = await self.a.history(now, self.days*1440)
            if len(rows) >= 300:
                cl, miss, _ = fill_grid(rows)
                e._audit("nextmove", "history_gaps" if miss > 0.02 else "learn", {"missing": miss} if miss > 0.02 else nm_learn(e.db, cl, now, H), now)
            e.db.commit()
        m = now//60000*60000
        due = e.db.execute("SELECT COUNT(*) FROM nm_predictions WHERE settled=0 AND target_ts+5000<=?", (now,)).fetchone()[0]
        if m == self.nm_min and not due: return
        self.nm_min = m; rows = await self.a.candles(now, 300); d = dict(rows)
        if rows and rows[-1][0] == m-60000 and now-m <= self.grace and not e.db.execute("SELECT 1 FROM nm_predictions WHERE made_ts=?", (m,)).fetchone():
            p = nm_predict(e.db, fill_grid(rows)[0], H, self.nm_thr)
            if p: e.db.execute("INSERT INTO nm_predictions(made_ts,target_ts,ref_price,p_up,lean_p,decision,version,validated) VALUES(?,?,?,?,?,?,?,?)",
                               (m, m+H*60000, rows[-1][1], p["p_up"], p["lean_p"], p["decision"], p["version"], int(p["validated"])))
        for r in e.db.execute("SELECT * FROM nm_predictions WHERE settled=0 AND target_ts+5000<=?", (now,)).fetchall():
            a, b = d.get(r["made_ts"]-60000), d.get(r["target_ts"]-60000)
            if a is not None and b is not None:
                e.db.execute("UPDATE nm_predictions SET close_price=?, outcome=?, settled=1 WHERE made_ts=?", (b, "UP" if b > a else "DOWN" if b < a else "TIE", r["made_ts"]))
            elif now - r["target_ts"] > 200*60000: e.db.execute("UPDATE nm_predictions SET outcome='MISSING', settled=1 WHERE made_ts=?", (r["made_ts"],))
    async def tick(self, now):
        e, log = self.e, []
        if hasattr(self.a, 'history'):
            try: await self._nm(now)
            except Exception as x: e._audit('nextmove', 'error', {'error': str(x)[:200]}, now)
        if self.pf: e.paused = os.path.exists(self.pf)
        for r in e.db.execute("SELECT * FROM rounds WHERE state IN('OPEN','LOCKED') ORDER BY open_ts").fetchall():
            ts, st = r["open_ts"], r["state"]
            if st == "OPEN" and now >= r["lock_ts"]: e.lock(ts, now); st = "LOCKED"; log.append(("lock", ts))
            if st == "LOCKED" and now >= r["close_ts"]:
                try: q = await self.a.latest()
                except Exception: q = {"price": None, "ts": None}
                out = e.settle(ts, q["price"], q["ts"], now); log.append((out, ts))
                if out in ("UP", "DOWN", "TIE"):
                    record_outcome(e.db, ts, out); self._maybe_learn(now)
                    if self.analyst:
                        try: a = await self.analyst("Explain the last settled round."); e._audit("analyst", "round_note", a, now)
                        except Exception as x: e._audit("analyst", "error", {"error": str(x)[:200]}, now)
        ts = now // e.round_ms * e.round_ms
        if not e.paused and now - ts <= self.grace and not e.db.execute("SELECT 1 FROM rounds WHERE open_ts=?", (ts,)).fetchone():
            try:
                q = await self.a.latest()
                if now - q["ts"] > STALE_MS or q["ts"] > now + STALE_MS: raise ValueError("stale or future price")
                cl = await self.a.closes(now)
                ver, w = active_model(e.db)
                f = nm_forecast(e.db, cl, now, self.nm_thr, e.round_ms//60000) or forecast(cl, q["price"], q["price"], (ts+e.round_ms-now)/1000, now-q["ts"], thr=self.thr, now=now, weights=w, version=ver)
                e.create_round(ts, q["price"], f); log.append(("open", ts))
                if f.get("features"):
                    ft = f["features"]; save_episode(e.db, ts, ft["regime"], [ft["vol_1m"]*100, ft["mom5"]*100, ft["mom15"]*100], f["explanation"], "coinbase:"+e.db.execute("SELECT version FROM forecasts WHERE round_ts=?", (ts,)).fetchone()[0], now)
                e.credit(self.user, 1000.0, "seed:"+self.user, "seed", now)
                if f["decision"] in ("UP", "DOWN"): e.bet(self.user, ts, f["decision"], self.stake, now); log.append(("agent_bet", f["decision"]))
            except Exception as x:
                e._audit("runner", "skip_round", {"round": ts, "reason": str(x)[:200]}, now); log.append(("skipped", str(x)[:80]))
        e.db.commit(); return log

async def run_forever(auto, interval=1.0):
    while True:
        try: await auto.tick(int(datetime.datetime.now(datetime.timezone.utc).timestamp()*1000))
        except Exception as x: auto.e._audit("runner", "tick_error", {"error": str(x)[:200]}); auto.e.db.commit(); await asyncio.sleep(5)
        await asyncio.sleep(interval)

MARKETS = {"SOL-5m": ("SOL-USD", 300_000, 30_000), "BTC-5m": ("BTC-USD", 300_000, 30_000), "BTC-1h": ("BTC-USD", 3_600_000, 120_000)}

def serve_health(autos, port):
    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(s):
            u = urllib.parse.urlparse(s.path)
            if u.path == "/predict":
                mk = urllib.parse.parse_qs(u.query).get("market", [None])[0]; a = autos.get(mk)
                r = a.e.db.execute("SELECT * FROM nm_predictions ORDER BY made_ts DESC LIMIT 1").fetchone() if a else None
                body = json.dumps({"market": mk, "latest": dict(r) if r else None, "live_stats": nm_stats(a.e.db) if a else None,
                                   "validated_model": nm_load(a.e.db, "active")[0] if a else None, "lean_model": nm_load(a.e.db, "lean")[0] if a else None}).encode()
                s.send_response(200 if a else 404); s.send_header("Content-Type", "application/json"); s.send_header("Access-Control-Allow-Origin", "*"); s.end_headers(); s.wfile.write(body); return
            out = {}
            for n, a in autos.items():
                e = a.e; v, _ = active_model(e.db)
                out[n] = {"paused": e.paused, "agent_balance": e.balance("agent"), "active_model": v or VERSION,
                          "recent_rounds": [dict(r) for r in e.db.execute("SELECT open_ts,ref_price,close_price,state,result FROM rounds ORDER BY open_ts DESC LIMIT 3")],
                          "nextmove_live": nm_stats(e.db), "lessons": [r["text"] for r in e.db.execute("SELECT text FROM lessons ORDER BY id DESC LIMIT 2")]}
            body = json.dumps({"ok": True, "markets": out}).encode()
            s.send_response(200); s.send_header("Content-Type", "application/json"); s.send_header("Access-Control-Allow-Origin", "*"); s.end_headers(); s.wfile.write(body)
        def log_message(s, *a): pass
    http.server.ThreadingHTTPServer(("0.0.0.0", port), H).serve_forever()

async def _run_all(autos): await asyncio.gather(*[run_forever(a) for a in autos.values()])

def main():
    d = os.getenv("LEXI_DIR", "."); client = groq_client() if os.getenv("GROQ_API_KEY") else None; autos = {}
    for n in os.getenv("LEXI_MARKETS", "SOL-5m,BTC-5m,BTC-1h").split(","):
        prod, rm, lb = MARKETS[n.strip()]; e = Engine(connect(f"{d}/{n.strip()}.db"), rm, lb)
        autos[n.strip()] = Autonomous(e, CoinbaseAdapter(prod), make_analyst(e, client) if client else None, pause_file=f"{d}/PAUSE")
    threading.Thread(target=serve_health, args=(autos, int(os.getenv("PORT", "8080"))), daemon=True).start()
    asyncio.run(_run_all(autos))

if __name__ == "__main__": main()
