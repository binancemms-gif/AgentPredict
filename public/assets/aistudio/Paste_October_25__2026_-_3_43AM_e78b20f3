SCHEMA = """
CREATE TABLE IF NOT EXISTS rounds(open_ts INTEGER PRIMARY KEY, ref_price REAL NOT NULL, lock_ts INTEGER NOT NULL,
  close_ts INTEGER NOT NULL, state TEXT NOT NULL, close_price REAL, result TEXT, note TEXT);
CREATE TABLE IF NOT EXISTS forecasts(round_ts INTEGER PRIMARY KEY REFERENCES rounds(open_ts), made_ts INTEGER NOT NULL,
  model TEXT NOT NULL, version TEXT NOT NULL, p_up REAL, decision TEXT NOT NULL, features TEXT, evidence TEXT,
  explanation TEXT, data_quality TEXT);
CREATE TRIGGER IF NOT EXISTS forecasts_immutable BEFORE UPDATE ON forecasts BEGIN SELECT RAISE(ABORT,'forecasts are immutable'); END;
CREATE TABLE IF NOT EXISTS bets(id INTEGER PRIMARY KEY AUTOINCREMENT, round_ts INTEGER NOT NULL, user TEXT NOT NULL,
  side TEXT NOT NULL CHECK(side IN('UP','DOWN')), stake REAL NOT NULL CHECK(stake>0), status TEXT NOT NULL DEFAULT 'OPEN');
CREATE TABLE IF NOT EXISTS ledger(id INTEGER PRIMARY KEY AUTOINCREMENT, user TEXT NOT NULL, delta REAL NOT NULL,
  idem_key TEXT UNIQUE NOT NULL, reason TEXT, ts INTEGER);
CREATE TABLE IF NOT EXISTS model_versions(version TEXT PRIMARY KEY, config TEXT NOT NULL, metrics TEXT, created_ts INTEGER);
CREATE TRIGGER IF NOT EXISTS mv_immutable BEFORE UPDATE ON model_versions BEGIN SELECT RAISE(ABORT,'model versions are immutable'); END;
