CREATE TABLE IF NOT EXISTS nm_pointer(kind TEXT PRIMARY KEY, version TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS nm_predictions(made_ts INTEGER PRIMARY KEY, target_ts INTEGER NOT NULL, ref_price REAL NOT NULL, p_up REAL NOT NULL, lean_p REAL NOT NULL,
  decision TEXT NOT NULL, version TEXT, validated INTEGER NOT NULL, close_price REAL, outcome TEXT, settled INTEGER NOT NULL DEFAULT 0);
